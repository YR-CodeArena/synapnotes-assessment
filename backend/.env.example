# Database — leave unset to use SQLite fallback (./synapnotes.db)
# PostgreSQL (Supabase / Neon pooler ready):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/synapnotes
DATABASE_URL=

# JWT
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# AI Engine — leave empty to use the deterministic mock fallback
GEMINI_API_KEY=
GROQ_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
